# Copy to .env and adjust. Every value can also be set as a real environment
# variable (those win over .env).

# ---- App ---------------------------------------------------------------------
APP_ENV=development              # development | production
APP_NAME=gcore
BASE_URL=http://localhost:3000   # public URL, no trailing slash (https:// enables Secure cookies)
PORT=3000                        # or ADDR=:3000
LOG_LEVEL=info                   # debug | info | warn | error

# ---- Database ----------------------------------------------------------------
# SQLite (zero setup, great for development):
DATABASE_URL=sqlite:data/blog.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgres://blog:blog@localhost:5432/blog?sslmode=disable
AUTO_MIGRATE=true                # apply pending migrations on startup
DB_DEBUG=false                   # log every SQL query

# ---- Sessions ----------------------------------------------------------------
# Required in production, at least 32 characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL=720h                 # how long a login lasts (30 days)

# ---- Google sign-in ----------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Web application") and add this Authorized redirect URI:
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=           # defaults to BASE_URL + /auth/google/callback

# Comma-separated Google accounts that become admins when they sign in.
ADMIN_EMAILS=admin@example.com

# Password-less "developer login" form on /login, for trying things out
# without Google credentials. Ignored when APP_ENV=production.
DEV_LOGIN=true

# ---- Uploads & content -------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=5
POSTS_PER_PAGE=9

# ---- Reverse proxy -----------------------------------------------------------
# Set when running behind nginx/Caddy/a load balancer so c.IP() is the client IP.
TRUST_PROXY=false
# TRUSTED_PROXIES=10.0.0.0/8
